# App Environment
NODE_ENV=development
PORT=4000
APP_NAME=OffRamp
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://offramp_user:offramp_secret_password@localhost:5432/offramp_db?schema=public

# Cache & Message Queue (Redis)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_ACCESS_SECRET=offramp_super_secret_access_jwt_key_change_in_prod_32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=offramp_super_secret_refresh_jwt_key_change_in_prod_32chars
JWT_REFRESH_EXPIRY=7d
PIN_HASH_SALT_ROUNDS=12

# Currency & Rates Configuration
DEFAULT_COUNTRY=NG
DEFAULT_FIAT=NGN
SUPPORTED_FIATS=NGN,GHS
RATE_REFRESH_INTERVAL_SECONDS=30
RATE_STALE_THRESHOLD_SECONDS=90
DEFAULT_SPREAD_PERCENTAGE=1.5

# Sandbox & Providers (Sandbox mode active)
WALLET_PROVIDER_MODE=sandbox
PAYOUT_PROVIDER_MODE=sandbox
KYC_PROVIDER_MODE=sandbox
RATE_PROVIDER_MODE=sandbox
